{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  null,
    "buildCommand":  null,
    "installCommand":  "",
    "outputDirectory":  ".",
    "cleanUrls":  true,
    "headers":  [
                    {
                        "source":  "/access/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store, max-age=0"
                                        },
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, noarchive, nosnippet"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "no-referrer"
                                        }
                                    ]
                    },
                    {
                        "source":  "/assets/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/media/posters/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/media/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=2592000, stale-while-revalidate=86400"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "Content-Disposition",
                                            "value":  "inline"
                                        },
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, noarchive, nosnippet"
                                        },
                                        {
                                            "key":  "Cross-Origin-Resource-Policy",
                                            "value":  "same-origin"
                                        }
                                    ]
                    },
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "picture-in-picture=(), display-capture=()"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "frame-ancestors \u0027none\u0027"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        }
                                    ]
                    }
                ]
}
