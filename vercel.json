{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/courses/ai-engineering",
      "destination": "/courses/ai-for-engineers/",
      "permanent": true
    },
    {
      "source": "/courses/ai-engineering/:path*",
      "destination": "/courses/ai-for-engineers/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/access/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/private-access/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/media/posters/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive, nosnippet"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), picture-in-picture=(), display-capture=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://*.clerk.accounts.dev https://*.clerk.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/academy/:path*",
      "destination": "/api/academy-router"
    },
    {
      "source": "/api/admin/admin-accounts",
      "destination": "/api/admin-router?__z7route=admin-accounts"
    },
    {
      "source": "/api/admin/files",
      "destination": "/api/admin-router?__z7route=files"
    },
    {
      "source": "/api/admin/course-engine",
      "destination": "/api/admin-router?__z7route=course-engine"
    },
    {
      "source": "/api/admin/file-manage",
      "destination": "/api/admin-router?__z7route=file-manage"
    },
    {
      "source": "/api/admin/all-clients",
      "destination": "/api/admin-router?__z7route=all-clients"
    },
    {
      "source": "/api/admin/blob-finalize",
      "destination": "/api/admin-router?__z7route=blob-finalize"
    },
    {
      "source": "/api/admin/blob-upload",
      "destination": "/api/admin-router?__z7route=blob-upload"
    },
    {
      "source": "/api/admin/blob-upload-intent",
      "destination": "/api/admin-router?__z7route=blob-upload-intent"
    },
    {
      "source": "/api/admin/client-file-access",
      "destination": "/api/admin-router?__z7route=client-file-access"
    },
    {
      "source": "/api/admin/clients",
      "destination": "/api/admin-router?__z7route=clients"
    },
    {
      "source": "/api/admin/user-password",
      "destination": "/api/admin-router?__z7route=user-password"
    },
    {
      "source": "/api/admin/user-role",
      "destination": "/api/admin-router?__z7route=user-role"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/admin-router?__z7route=users"
    },
    {
      "source": "/api/admin/user-status",
      "destination": "/api/admin-router?__z7route=user-status"
    },
    {
      "source": "/api/portal/config",
      "destination": "/api/portal-router?__z7route=config"
    },
    {
      "source": "/api/portal/me",
      "destination": "/api/portal-router?__z7route=me"
    },
    {
      "source": "/api/private-auth/admin-login",
      "destination": "/api/private-auth-router?__z7route=admin-login"
    },
    {
      "source": "/api/private-auth/admin-logout",
      "destination": "/api/private-auth-router?__z7route=admin-logout"
    },
    {
      "source": "/api/private-auth/admin-status",
      "destination": "/api/private-auth-router?__z7route=admin-status"
    },
    {
      "source": "/api/private-auth/hub-login",
      "destination": "/api/private-auth-router?__z7route=hub-login"
    },
    {
      "source": "/api/private-auth/hub-logout",
      "destination": "/api/private-auth-router?__z7route=hub-logout"
    },
    {
      "source": "/api/private-auth/hub-status",
      "destination": "/api/private-auth-router?__z7route=hub-status"
    },
    {
      "source": "/api/private-auth/login",
      "destination": "/api/private-auth-router?__z7route=login"
    },
    {
      "source": "/api/private-auth/logout",
      "destination": "/api/private-auth-router?__z7route=logout"
    },
    {
      "source": "/api/private-auth/portal-file",
      "destination": "/api/private-auth-router?__z7route=portal-file"
    },
    {
      "source": "/api/private-auth/portal-files",
      "destination": "/api/private-auth-router?__z7route=portal-files"
    },
    {
      "source": "/api/private-documents/blueprint",
      "destination": "/api/private-documents-router?__z7route=blueprint"
    },
    {
      "source": "/api/private-auth/resource-check",
      "destination": "/api/private-auth-router?__z7route=resource-check"
    }
  ]
}
